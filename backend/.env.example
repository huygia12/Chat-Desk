# ======= DATABASE =======
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/chatdesk

# ======= JWT AUTH =======
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ======= AI / LLM =======
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5.5
EMBEDDING_MODEL=all-MiniLM-L6-v2
AI_REWRITE_ENABLED=true
AI_REWRITE_CONFIDENCE_THRESHOLD=0.4
AI_REWRITE_TIMEOUT_SECONDS=2.0
AI_RETRIEVAL_HIGH_CONFIDENCE_THRESHOLD=0.35
AI_RETRIEVAL_MIN_SCORE=0.3
AI_RETRIEVAL_SCORE_MARGIN=0.05
AI_RETRIEVAL_MIN_MESSAGE_LENGTH=12

# ======= MILVUS CLOUD (Zilliz) =======
# Get from: https://cloud.zilliz.com/ -> Cluster -> Connect
MILVUS_URI=https://in03-xxxxxxx.serverless.aws-eu-central-1.cloud.zilliz.com
MILVUS_TOKEN=your-milvus-token

# ======= FACEBOOK =======
# Get from: https://developers.facebook.com/ -> Your App -> Settings -> Basic
FB_APP_ID=your-facebook-app-id
FB_APP_SECRET=your-facebook-app-secret
FB_VERIFY_TOKEN=chatdesk_verify_token
FB_OAUTH_REDIRECT_URI=http://localhost:8000/api/channels/facebook/callback
# Optional: Facebook Login for Business configuration ID.
# If set, OAuth uses config_id instead of classic scope-based login.
# Add business_management to that configuration in Meta Dashboard; changing
# META_OAUTH_SCOPES in code only affects the classic scope-based fallback.
FB_CONFIG_ID=

# ======= CORS =======
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ======= API / UPLOADS =======
# Public backend URL used to build downloadable file URLs.
API_URL=http://localhost:8000
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=15728640
