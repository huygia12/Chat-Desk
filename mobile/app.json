{
  "expo": {
    "name": "ChatDesk",
    "slug": "chatdesk-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "chatdesk",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.chatdesk.mobile",
      "permissions": [
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-notifications",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": ""
      }
    }
  }
}
